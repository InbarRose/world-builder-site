{
  "name": "world-builder-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run",
    "supabase:types": "node scripts/generate-types.js",
    "supabase:types:local": "supabase gen types typescript --local > src/lib/database.types.ts",
    "supabase:link": "supabase link --project-ref $SUPABASE_PROJECT_REF",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "prepare": "cd .. && husky install frontend/.husky",
    "format": "prettier --write .",
    "precommit": "lint-staged && npm run test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "vitest related --run"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.3.4",
    "clsx": "^1.2.1",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.8",
    "autoprefixer": "^10.4.14",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "jsdom": "^22.1.0",
    "lint-staged": "^16.2.6",
    "postcss": "^8.4.21",
    "supabase": "^1.183.0",
    "tailwindcss": "^3.2.7",
    "typescript": "~5.1.6",
    "vite": "^4.3.2"
  }
  ,
  "engines": {
    "node": ">=22.12.0"
  }
}