{
    "version": 2,
    "builds": [
        {
            "src": "src/app/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/app/main.py"
        }
    ],
    "env": {
        "PYTHON_VERSION": "3.12",
        "POETRY_VERSION": "1.7.1"
    }
}